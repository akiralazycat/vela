{
  "name": "vela-site",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "npm run package:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "package:build": "npm run build --workspace @vela/player",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "shaka-player": "^5.2.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22"
  }
}
